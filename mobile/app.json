{
  "expo": {
    "name": "Chat Web",
    "slug": "chat-web-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "chatwebmobile",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "READ_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "READ_MEDIA_AUDIO"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#2563eb"
      }
    },
    "plugins": ["expo-image-picker"]
  }
}
